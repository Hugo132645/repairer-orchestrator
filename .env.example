# Select "azure_openai_v1" or "gemini".
LLM_PROVIDER=azure_openai_v1

# Azure OpenAI-compatible v1 authentication. AGENT_MODEL must be the Azure
# deployment name, which can differ from the underlying model family name.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://your-resource-name.services.ai.azure.com/openai/v1/
AGENT_MODEL=gpt-5-1

# Gemini alternative:
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# AGENT_MODEL=gemini-3.6-flash

APP_ENV=local
LOG_LEVEL=INFO
LOG_DIRECTORY=logs
AUDIT_LOG_FILENAME=audit.jsonl
APPLICATION_LOG_FILENAME=application.jsonl
ENABLE_CONSOLE_LOGS=TRUE
ENABLE_FILE_LOGS=TRUE
ENABLE_OTEL=TRUE
OTEL_CONSOLE_EXPORTER=FALSE
OTEL_SERVICE_NAMESPACE=repairer-orchestrator-prototype

ORCHESTRATOR_PORT=8000
SERVICE_REGISTRY_PATH=repairer_orchestrator/service_agents.json
MAX_TEXT_LOG_CHARS=500
TOOL_TIMEOUT_SECONDS=20
